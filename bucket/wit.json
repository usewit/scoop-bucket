            "hash": "d758b0dd2fcef8a7f592da238f2449bac80dce3164be6c82a83c93591f821c3e"
        }
    },
    "installer": {
        "script": [
            "Start-Process -Wait -FilePath \"$dir\\setup.exe\" -ArgumentList '/S', \"/D=$dir\"",
            "Remove-Item \"$dir\\setup.exe\""
        ]
    },
    "uninstaller": {
        "script": "if (Test-Path \"$dir\\uninstall.exe\") { Start-Process -Wait -FilePath \"$dir\\uninstall.exe\" -ArgumentList '/S', \"_?=$dir\" }"
    },
    "checkver": {
        "github": "https://github.com/usewit/wit"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/usewit/wit/releases/download/v$version/Wit_$version_x64-setup.exe#/setup.exe"
            }
        }
    }
}
